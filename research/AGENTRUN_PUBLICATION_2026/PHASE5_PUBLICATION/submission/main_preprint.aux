\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces The pre-registered confirmatory results. Differences are in percentage points of task success, paired within model and decoding, pooled over the four primary models (268 tasks, 135 families, 51{,}456 runs). Intervals are 95\% percentile bootstraps over families (10{,}000 seeded resamples); $p$ is a two-sided sign-flip permutation test on family-level summed differences (100{,}000 seeded draws, Monte-Carlo floor $1\times 10^{-5}$); Holm correction is over these four contrasts at $\alpha =0.05$. S4 is a harm test and is reported as \emph  {not falsified}, not as a fifth supported hypothesis.}}{15}{table.5}\protected@file@percent }
\newlabel{tab:primary}{{5}{15}{The pre-registered confirmatory results. Differences are in percentage points of task success, paired within model and decoding, pooled over the four primary models (268 tasks, 135 families, 51{,}456 runs). Intervals are 95\% percentile bootstraps over families (10{,}000 seeded resamples); $p$ is a two-sided sign-flip permutation test on family-level summed differences (100{,}000 seeded draws, Monte-Carlo floor $1\times 10^{-5}$); Holm correction is over these four contrasts at $\alpha =0.05$. S4 is a harm test and is reported as \emph {not falsified}, not as a fifth supported hypothesis}{table.5}{}}
\newlabel{tab:primary@cref}{{[table][5][]5}{[1][14][]15}}
